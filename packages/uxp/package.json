{
  "name": "com.rmurai.premianno",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "cross-env MODE=dev vite build --watch",
    "build": "cross-env MODE=build vite build",
    "ccx": "cross-env MODE=package vite build && node scripts/rename-artifacts.mjs",
    "zip": "cross-env MODE=zip vite build && node scripts/rename-artifacts.mjs",
    "ccx-install": "cross-env BOLT_ACTION=ccx-install vite",
    "ccx-uninstall": "cross-env BOLT_ACTION=ccx-uninstall vite"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@adobe/cc-ext-uxp-types": "^7.3.1",
    "@adobe/premierepro": "^26.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "sass": "^1.104.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-uxp-plugin": "^1.3.8",
    "vitest": "^4.1.11"
  }
}
