{
  "name": "com.rmurai.premianno",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "cross-env MODE=dev vite build --watch",
    "build": "cross-env MODE=build vite build",
    "ccx": "cross-env MODE=package vite build && node scripts/rename-artifacts.mjs",
    "zip": "cross-env MODE=zip vite build && node scripts/rename-artifacts.mjs",
    "ccx-install": "cross-env BOLT_ACTION=ccx-install vite",
    "ccx-uninstall": "cross-env BOLT_ACTION=ccx-uninstall vite"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@adobe/cc-ext-uxp-types": "^7.3.1",
    "@adobe/premierepro": "^26.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "sass": "^1.104.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-uxp-plugin": "^1.3.26",
    "vitest": "^4.1.12"
  }
}
